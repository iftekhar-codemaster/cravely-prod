{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cravely-prod.vercel.app" }],
      "destination": "https://app.cravely.space/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cravely.zone.id" }],
      "destination": "https://app.cravely.space/:path*",
      "permanent": true
    }
  ]
}
